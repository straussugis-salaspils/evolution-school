{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "functions": {
    "api/relationship-attribution.js": {
      "regions": ["fra1"],
      "maxDuration": 10
    },
    "api/relationship-attribution-click.js": {
      "regions": ["fra1"],
      "maxDuration": 10
    },
    "api/relationship-funnel-dashboard.js": {
      "regions": ["fra1"],
      "maxDuration": 15
    },
    "api/relationship-funnel-v2-dashboard.js": {
      "regions": ["fra1"],
      "maxDuration": 25
    }
  },
  "rewrites": [
    {
      "source": "/18-18-18/relationship-statistics/",
      "destination": "/api/relationship-funnel-v2-dashboard"
    },
    {
      "source": "/relationship-test/relationship-challenges/",
      "destination": "/relationship-test/"
    },
    {
      "source": "/relationship-test/stay-or-leave/",
      "destination": "/relationship-test/"
    },
    {
      "source": "/relationship-test/tired-function/",
      "destination": "/relationship-test/"
    }
  ],
  "redirects": [
    {
      "source": "/18-18-18/relationship-funnel/",
      "destination": "/18-18-18/relationship-statistics/",
      "permanent": true
    },
    {
      "source": "/18-18-18/relationship-funnel-v2/",
      "destination": "/18-18-18/relationship-statistics/",
      "permanent": true
    },
    {
      "source": "/test-arhetipov/",
      "destination": "/arhetipy.html",
      "permanent": true
    },
    {
      "source": "/individualnyj-retrit.html",
      "destination": "/urovni-zhizni/individualnyj-retrit/",
      "permanent": true
    },
    {
      "source": "/urovni-zhizni/individualnyj-retrit.html",
      "destination": "/urovni-zhizni/individualnyj-retrit/",
      "permanent": true
    },
    {
      "source": "/vysokaya-glubina.html",
      "destination": "/mentoring/",
      "permanent": true
    }
  ]
}
